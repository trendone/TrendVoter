{% extends 'ToaLayoutBundle:bootstrap3:layout.html.twig' %}

{% block title %}TrendOne TrendVoter{% endblock %}

{% block stylesheets %}
    {% stylesheets
        'bundles/trendonetrendvoter/less/bootstrap.less'
        'bundles/trendonetrendvoter/less/layout.less'
        filter='cssrewrite,?yui_css'
    %}
        <link href="{{ asset_url }}" rel="stylesheet" type="text/css" />
    {% endstylesheets %}
{% endblock %}

{% macro message(status, message) %}
    <div class="alert alert-{{ status }} alert-dismissable">
        <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
        {{ message }}
    </div>
{% endmacro %}

{% block body %}
    {{ block('topnavbar') }}

    <div class="container">
    {% for flashMessage in app.session.flashbag.get('notice') %}
        {{ _self.message('success', flashMessage) }}
    {% endfor %}

    {% for flashMessage in app.session.flashbag.get('error') %}
        {{ _self.message('danger', flashMessage) }}
    {% endfor %}
    </div>

    {{ parent() }}
{% endblock %}

{% block topnavbar %}
    <nav class="navbar navbar-default navbar-fixed-top" role="navigation">
        <div class="container">

            <!-- Brand and toggle get grouped for better mobile display -->
            <div class="navbar-header">
                <button type="button" class="navbar-toggle" data-toggle="collapse" data-target="#topnavbar-collapse">
                    {% for a in 0..2 -%}
                        <span class="icon-bar"></span>
                    {%- endfor %}
                </button>

                {% block topnavbar_brand %}
                    <a class="navbar-brand" href="#">TrendVoter</a>
                {% endblock %}
            </div>

            <!-- Collect the nav links, forms, and other content for toggling -->
            <div class="collapse navbar-collapse" id="topnavbar-collapse">
                {% block topnavbar_menu '' %}
            </div>
        </div>
    </nav>
{% endblock %}

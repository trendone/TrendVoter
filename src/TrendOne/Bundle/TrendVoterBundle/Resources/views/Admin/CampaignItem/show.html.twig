{% extends 'TrendOneTrendVoterBundle:Admin:layout.html.twig' %}

{% block content -%}
    <h1>CampaignItem</h1>

    <table class="table table_condensed">
        <tbody>
            <tr>
                <th>Image</th>
                <td>{{ entity.imageResource }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ entity.description }}</td>
            </tr>
        </tbody>
    </table>

    <a class="btn btn-default" href="{{ path('trendone_trendvoter_admin_campaignitem_edit', { 'id': entity.id, 'campaign': entity.campaign.id }) }}">
        Edit
    </a>

    <br /><br />

    {{ form(delete_form) }}

    <br />

    <a class="btn btn-default" href="{{ path('trendone_trendvoter_admin_campaignitem_index', {'campaign': entity.campaign.id}) }}">
        Back to the list
    </a>
{% endblock %}

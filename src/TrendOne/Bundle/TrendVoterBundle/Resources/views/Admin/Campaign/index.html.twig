{% extends 'TrendOneTrendVoterBundle:Admin:layout.html.twig' %}

{% block content -%}
    <h1>Campaign list</h1>

    <div class="text-center">
        {{ pagerfanta(pager, 'twitter_bootstrap3_translated') }}
    </div>

    <table class="table table-condensed">
        <thead>
            <tr>
                <th>Title</th>
                <th class="hidden-xs">Description</th>
                <th>Items</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        {% for entity in entities %}
            <tr>
                <td>{{ entity.title }}</td>
                <td class="hidden-xs">{{ entity.description|nl2br }}</td>
                <td>{{ entity.items|length }}</td>
                <td>
                        <a class="btn btn-primary" href="{{ path('trendone_trendvoter_frontend_campaign_show', {'campaign': entity.slug}) }}" target="_blank"><span class="glyphicon glyphicon-star hidden-md"></span><span class="hidden-xs hidden-sm"> live</span></a>
                        <a class="btn btn-default" href="{{ path('trendone_trendvoter_admin_campaign_show', { 'id': entity.id }) }}"><span class="glyphicon glyphicon-stats hidden-md"></span><span class="hidden-xs hidden-sm"> show</span></a>
                        <a class="btn btn-default" href="{{ path('trendone_trendvoter_admin_campaign_edit', { 'id': entity.id }) }}"><span class="glyphicon glyphicon-pencil hidden-md"></span><span class="hidden-xs hidden-sm"> edit</span></a>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <div class="text-center">
        {{ pagerfanta(pager, 'twitter_bootstrap3_translated') }}
    </div>

    <a class="btn btn-default" href="{{ path('trendone_trendvoter_admin_campaign_new') }}">
        Create a new campaign
    </a>
{% endblock %}

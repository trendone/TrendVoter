{% extends 'TrendOneTrendVoterBundle:Admin:layout.html.twig' %}

{% block content -%}
    <h1>Campaign list</h1>

    <div class="text-center">
        {{ pagerfanta(pager, 'twitter_bootstrap3_translated') }}
    </div>

    <table class="table table-condensed">
        <thead>
            <tr>
                <th>Title</th>
                <th>Description</th>
                <th>Items</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        {% for entity in entities %}
            <tr>
                <td>{{ entity.title }}</td>
                <td>{{ entity.description|nl2br }}</td>
                <td>{{ entity.items|length }}</td>
                <td>
                    <div class="btn-group btn-group-xs">
                        <a class="btn btn-primary" href="{{ path('trendone_trendvoter_frontend_campaign_show', {'campaign': entity.slug}) }}" target="_blank">live</a>
                        <a class="btn btn-default" href="{{ path('trendone_trendvoter_admin_campaign_show', { 'id': entity.id }) }}">show</a>
                        <a class="btn btn-default" href="{{ path('trendone_trendvoter_admin_campaign_edit', { 'id': entity.id }) }}">edit</a>
                    </div>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <div class="text-center">
        {{ pagerfanta(pager, 'twitter_bootstrap3_translated') }}
    </div>

    <a class="btn btn-default" href="{{ path('trendone_trendvoter_admin_campaign_new') }}">
        Create a new campaign
    </a>
{% endblock %}

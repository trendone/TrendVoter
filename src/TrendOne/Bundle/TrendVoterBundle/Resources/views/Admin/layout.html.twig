{% extends 'TrendOneTrendVoterBundle::layout.html.twig' %}

{% block title %}{{ parent() }} - Admin{% endblock %}

{% block topnavbar_brand %}
    <a class="navbar-brand" href="{{ path('trendone_trendvoter_admin_default_index') }}">TrendVoter</a>
{% endblock %}

{% block topnavbar_menu %}
    <ul class="nav navbar-nav">
        <li class="{{ 'trendone_trendvoter_admin_campaign' in app.request.get('_route') ? 'active' }}"><a href="{{ path('trendone_trendvoter_admin_campaign_index') }}">{{ 'Campaigns'|trans }}</a></li>
    </ul>

    <ul class="nav navbar-nav navbar-right">
        <li class="dropdown">
            <a href="#" class="dropdown-toggle" data-toggle="dropdown">{{ 'Signed in as {{ username }}'|trans({'{{ username }}': app.user.username}) }} <b class="caret"></b></a>
            <ul class="dropdown-menu">
                <li><a href="{{ path('toa_layout_security_logout') }}">{{ 'Logout'|trans }}</a></li>
            </ul>
        </li>
    </ul>
{% endblock %}

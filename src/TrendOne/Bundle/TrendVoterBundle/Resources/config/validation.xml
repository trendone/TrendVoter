<?xml version="1.0" encoding="UTF-8" ?>
<constraint-mapping xmlns="http://symfony.com/schema/dic/constraint-mapping"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://symfony.com/schema/dic/constraint-mapping http://symfony.com/schema/dic/constraint-mapping/constraint-mapping-1.0.xsd">

    <class name="TrendOne\Bundle\TrendVoterBundle\Entity\Campaign">
        <property name="title">
            <constraint name="NotBlank" />
            <constraint name="Regex">
                <option name="value">/^admin$/i</option>
                <option name="match">false</option>
            </constraint>
        </property>
        <property name="description">
            <constraint name="NotBlank" />
        </property>
        <property name="questionX">
            <constraint name="NotBlank" />
        </property>
        <property name="questionY">
            <constraint name="NotBlank" />
        </property>
    </class>

    <class name="TrendOne\Bundle\TrendVoterBundle\Entity\CampaignItem">
        <property name="title">
            <constraint name="NotBlank" />
        </property>
        <property name="imageResource">
            <constraint name="Image" />
        </property>
        <property name="description">
            <constraint name="NotBlank" />
        </property>
    </class>

    <class name="TrendOne\Bundle\TrendVoterBundle\Entity\CampaignItemAnswer">
        <property name="answerX">
            <constraint name="NotBlank" />
        </property>
        <property name="answerY">
            <constraint name="NotBlank" />
        </property>
    </class>
</constraint-mapping>
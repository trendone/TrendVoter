<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <parameters>
        <parameter key="trend_one_trend_voter.session_identifier_listener.class">TrendOne\Bundle\TrendVoterBundle\EventListener\SessionIdentifierListener</parameter>
    </parameters>

    <services>
        <service id="trend_one_trend_voter.session_identifier_listener" class="%trend_one_trend_voter.session_identifier_listener.class%" scope="request">
            <tag name="kernel.event_subscriber" />
            <argument type="service" id="security.secure_random" />
        </service>
    </services>
    

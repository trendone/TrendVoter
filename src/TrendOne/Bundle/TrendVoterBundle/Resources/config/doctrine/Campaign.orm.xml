<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping 
    xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping" 
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd"
    xmlns:gedmo="http://gediminasm.org/schemas/orm/doctrine-extensions-mapping">
    <entity
        name="TrendOne\Bundle\TrendVoterBundle\Entity\Campaign"
        repository-class="TrendOne\Bundle\TrendVoterBundle\Entity\Repository\CampaignRepository">
        <id name="id" type="integer">
            <generator strategy="AUTO" />
        </id>

        <field name="title" type="string" length="255" />
    
        <field name="description" type="text" />

        <field name="slug" type="string" length="255">
            <gedmo:slug fields="title" />
        </field>

        <field name="questionX" type="string" length="255" />

        <field name="questionY" type="string" length="255" />

        <one-to-many 
            field="items" 
            target-entity="TrendOne\Bundle\TrendVoterBundle\Entity\CampaignItem"
            mapped-by="campaign">
            <cascade>
                <cascade-persist />
                <cascade-remove />
            </cascade>
            <order-by>
                <order-by-field name="id" direction="ASC" />
            </order-by>
        </one-to-many>

        <field name="createdAt" type="datetime">
            <gedmo:timestampable on="create" />
        </field>

        <field name="updatedAt" type="datetime">
            <gedmo:timestampable on="update" />
        </field>
        
        <field name="deletedAt" type="datetime" nullable="true" />

        <gedmo:soft-deleteable field-name="deletedAt" time-aware="false" />
    </entity>
</doctrine-mapping>
